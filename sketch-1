setcpm(100/4)

const bass = n("1 <[5] [5!2 3]> <5 3!2> <1 3>")
  .scale("<G1!8 D1!8>:<minor major>:pentatonic")
  .s("gm_acoustic_bass")
  .gain(rand.range(0.7, 0.9))
  .pan(.55)
  .room(.3)
  .add(note(perlin.range(0,.2)))
  .when("<0!4 1!8>", x=>x.struct("[x@1 x@3]*<4!5 5>"))
  .delay("<0 .25 .5 1>")

const drums = s(`
[ hh hh hh hh ] [ hh hh hh hh ] [ hh hh hh hh ] [ hh hh oh hh ],
[ -  -  -  -  ] [ sd -  -  -  ] [ -  -  -  -  ] [ sd -  -  -  ],
[ bd bd -  -  ] [ -  -  -  bd ] [ -  -  bd bd ] [ -  -  -  -  ]
`).bank("RolandTR808")
.gain(rand.range(0.8, 1)).pan(.45)
.lpf(sine.range(2000, 3000).slow(4))

const sub = n("1@3 1")
.scale("<~!8 D1!8>:<minor major>:pentatonic")
.s(sine.range(850, 1500))

const chords = chord(`<
[Gm7 G7]!4
[Dm7 D7]!4
>`).slow(2).s("gm_pad_halo")
.voicing()
.struct("x@6 x@2")
.gain(0.2)
.pan(sine.range(.25,.75).slow(8))
.lpf(600).bpdepthfrequency("<200 500 100 0>")
.room("<.8>")

const drumBass = stack(drums, bass)
const drumBassSub = stack(drums, bass, sub)
const drumChords = stack(drums, chords)
const drumBassChords = stack(drums, bass, chords)
const drumChordsSub = stack(drums, chords, sub)
const drumBassChordsSub = stack(drums, bass, chords, sub)
const bassChords = stack(bass, chords)
const bassChordsSub = stack(bass, chords, sub)

arrange (
  [4, drums],
  [12, drumBass],
  [12, drumBassChords],
  [4, drumBass],
  [4, drumBassChords],
  [12, bassChords],
  [12, drumBassChordsSub],
  [4, bassChordsSub],
  [4, bassChords]
)._spectrum()
